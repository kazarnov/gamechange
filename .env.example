# --- LLM (Ollama cloud) ---
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
LLM_MODEL=glm-5.3-flash
# Other Ollama cloud models tested as the agent: deepseek-v4.1-flash, gemma4:31b (see README, Tuning).
# true | false | low | medium | high. GLM 5.3 Flash leaks reasoning into the spoken
# reply when this is false, so "low" is the fastest clean setting.
LLM_THINK=low

# --- ASR (NVIDIA Nemotron 3.5 ASR) ---
ASR_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
# "auto" detects the language; or force a locale like en-US, fr-FR
ASR_LANGUAGE=auto
# streaming = partial transcripts while you talk; offline = transcribe once you stop
ASR_MODE=streaming
# Lookahead tokens -> latency: 0=80ms, 3=320ms, 6=560ms, 13=1120ms
ASR_LOOKAHEAD=3
ASR_DEVICE=cuda
ASR_DTYPE=float16

# --- TTS (OmniVoice) ---
# TTS_NUM_STEP: diffusion steps. 8 is ~2x faster than 16 with no intelligibility loss in tests
TTS_MODEL=k2-fsa/OmniVoice
TTS_DEVICE=cuda
# float32 on GTX 16xx (fp16 there is slow and gives garbled audio); float16 is fine on RTX cards
TTS_DTYPE=float32
TTS_NUM_STEP=8
TTS_SPEED=1.0
# Voice used to create the default voice once (cached in voices/default.pt)
TTS_VOICE_INSTRUCT=female, moderate pitch, american accent
# Optional: clone a voice instead (wav file, ~5-15 s). If TTS_REF_TEXT is empty the
# clip is transcribed automatically with the ASR model.
TTS_REF_AUDIO=
TTS_REF_TEXT=
# Optional: speech from a VoiceStudio server instead of this PC's GPU (same OmniVoice model),
# e.g. https://<pod-id>-8002.proxy.runpod.net. Empty = OmniVoice here, with the settings above.
TTS_URL=
TTS_API_KEY=
# A VoiceStudio voice profile's name or id, or an OpenAI voice name (alloy = the server's default)
TTS_VOICE=alloy

# --- Turn taking (server-side VAD) ---
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=600
VAD_MIN_SPEECH_MS=250

# --- Browser agent (Playwright) ---
BROWSER_ENABLED=true
# The site the agent works on; it opens here at startup
WEBSITE_URL=https://demo.playwright.dev/todomvc/
# false = visible Chromium window (WSLg/desktop); forced true when there is no display
BROWSER_HEADLESS=false
# Cookies and logins persist in this folder: log in once in the window and it sticks
BROWSER_PROFILE_DIR=browser-profile
# Empty = same model as LLM_MODEL
BROWSER_LLM_MODEL=
BROWSER_LLM_THINK=low
BROWSER_MAX_STEPS=25
BROWSER_SCREENSHOTS=true
SKILLS_DIR=skills

# --- Pictures and videos (ComfyUI on RunPod, see comfyui/API.md) ---
# The pod's API URL (port 8000): https://<pod-id>-8000.proxy.runpod.net. Empty = off.
# It changes with every new pod; the key does not.
COMFYUI_URL=
# MANAGER_API_KEY from comfyui/pod.env
COMFYUI_API_KEY=
# What each workflow is for (shown to the assistant)
COMFYUI_DESCRIPTIONS=comfyui/descriptions.yaml
COMFYUI_TIMEOUT_MINUTES=30
# Generated and attached files are kept here and shown in the web UI
MEDIA_DIR=media
# Conversations are kept here, so they can be listed and reopened (not served)
DATA_DIR=data

# --- Content studio (post drafts for Instagram and X) ---
# How to make each kind of post: one markdown file per skill (see skills/content/_template.md)
CONTENT_SKILLS_DIR=skills/content
# Fonts for text on pictures: any .ttf/.otf file here can be used by its file name
FONTS_DIR=fonts

# --- FlowAI (content-generator/): saving, finding and scheduling posts ---
# Its API, e.g. http://localhost:8002 for the local docker stack. Empty = off.
# From the agent's own container (docker compose up), use http://host.docker.internal:8002.
FLOWAI_URL=
# The dashboard: links to posts point here. Until FlowAI issues the assistant a token, the
# assistant signs in as this user, and FlowAI only accepts that from one of its
# SANCTUM_STATEFUL_DOMAINS (localhost:5173 in the local stack).
FLOWAI_DASHBOARD_URL=http://localhost:5173
FLOWAI_EMAIL=
FLOWAI_PASSWORD=

# --- Docker (docker-compose.yml) ---
# The port the agent page is published on
AGENT_PORT=8000
